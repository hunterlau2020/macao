{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/review_disposition.schema.json",
  "title": "MACAO executor.disposition.yml Review Disposition Manifest",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "checkpoint_ref",
    "review_round",
    "executor",
    "disposition_status",
    "dispositions",
    "full_document",
    "issues_index_sha256"
  ],
  "properties": {
    "version": { "type": "string" },
    "timestamp": { "type": "string" },
    "task_id": { "type": "string", "minLength": 1 },
    "checkpoint_ref": { "type": "string", "minLength": 1 },
    "review_round": { "type": "integer", "minimum": 1 },
    "executor": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "cli": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "full_document": {
      "type": "object",
      "required": ["path", "evidence_commit", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "evidence_commit": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "vote_result_ref": {
      "type": "object",
      "required": ["path", "evidence_commit", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "evidence_commit": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "issues_index_sha256": { "type": "string", "minLength": 1 },
    "disposition_status": { "enum": ["DRAFT", "FINAL", "PENDING_ADMIN"] },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "disposition_type", "requires_new_checkpoint", "rationale"],
        "properties": {
          "issue_id": { "type": "string" },
          "reviewer_id": { "type": "string" },
          "disposition_type": { "enum": ["ADOPTED", "DEFERRED", "REJECTED", "NEEDS_ADMIN", "EXEMPTED_BY_ADMIN"] },
          "requires_new_checkpoint": { "type": "boolean" },
          "rationale": { "type": "string", "minLength": 1 },
          "override_id": { "type": "string" },
          "full_document": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "evidence_commit": { "type": "string" },
              "sha256": { "type": "string" },
              "anchor": { "type": "string" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "disposition_type": { "const": "EXEMPTED_BY_ADMIN" } },
              "required": ["disposition_type"]
            },
            "then": {
              "properties": {
                "override_id": { "type": "string", "minLength": 1 },
                "requires_new_checkpoint": { "const": false }
              },
              "required": ["override_id"]
            }
          },
          {
            "if": {
              "properties": { "disposition_type": { "const": "DEFERRED" } },
              "required": ["disposition_type"]
            },
            "then": {
              "properties": {
                "requires_new_checkpoint": { "const": false }
              }
            }
          },
          {
            "if": {
              "properties": { "disposition_type": { "const": "REJECTED" } },
              "required": ["disposition_type"]
            },
            "then": {
              "properties": {
                "requires_new_checkpoint": { "const": false }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "disposition_status": { "const": "FINAL" } },
        "required": ["disposition_status"]
      },
      "then": {
        "properties": {
          "dispositions": {
            "type": "array",
            "items": {
              "properties": {
                "disposition_type": {
                  "not": { "const": "NEEDS_ADMIN" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
