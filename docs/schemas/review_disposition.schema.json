{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/review_disposition.schema.json",
  "title": "MACAO executor.disposition.yml Review Disposition Manifest",
  "type": "object",
  "required": ["version", "task_id", "checkpoint_ref", "review_round", "executor", "disposition_status", "dispositions"],
  "properties": {
    "version": { "type": "string" },
    "timestamp": { "type": "string" },
    "task_id": { "type": "string", "minLength": 1 },
    "checkpoint_ref": { "type": "string", "minLength": 1 },
    "review_round": { "type": "integer", "minimum": 1 },
    "executor": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "cli": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "full_document": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "evidence_commit": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "disposition_status": { "enum": ["DRAFT", "FINAL", "PENDING_ADMIN"] },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "disposition_type", "requires_new_checkpoint", "rationale"],
        "properties": {
          "issue_id": { "type": "string" },
          "reviewer_id": { "type": "string" },
          "disposition_type": { "enum": ["ADOPTED", "DEFERRED", "REJECTED", "NEEDS_ADMIN", "EXEMPTED_BY_ADMIN"] },
          "requires_new_checkpoint": { "type": "boolean" },
          "rationale": { "type": "string" },
          "override_id": { "type": "string" },
          "full_document": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "evidence_commit": { "type": "string" },
              "sha256": { "type": "string" },
              "anchor": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
