{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/review_context.schema.json",
  "title": "MACAO REVIEW_REQUEST review_context（唯一权威结构，见 PRD §5.2）",
  "type": "object",
  "required": [
    "repository",
    "dev_checkpoint",
    "evidence",
    "task_info",
    "code_changes",
    "quality_snapshot",
    "executor_self_assessment",
    "review_guidelines",
    "history",
    "references"
  ],
  "properties": {
    "required_blocks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dev_checkpoint": {
      "type": "object",
      "required": ["path", "commit", "sha256", "base_commit", "head_commit", "review_round"],
      "properties": {
        "path": { "type": "string" },
        "commit": { "type": "string" },
        "sha256": { "type": "string" },
        "base_commit": { "type": "string" },
        "head_commit": { "type": "string" },
        "review_round": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["workspace_path", "remote_name"],
      "properties": {
        "workspace_path": { "type": "string", "minLength": 1 },
        "remote_name": { "type": ["string", "null"] },
        "fetch_policy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["ref", "commit", "dev_manifest"],
      "properties": {
        "ref": { "type": "string" },
        "commit": { "type": "string" },
        "dev_manifest": {
          "type": "object",
          "required": ["path", "commit", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "commit": { "type": "string" },
            "sha256": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "task_info": {
      "type": "object",
      "required": ["description", "source", "path", "commit", "sha256"],
      "properties": {
        "description": { "type": "string" },
        "source": { "type": "string" },
        "path": { "type": "string" },
        "commit": { "type": "string" },
        "sha256": { "type": "string" },
        "business_impact": { "type": "string" },
        "timeline_info": { "type": "string" },
        "review_focus": { "type": "array", "items": { "type": "string" } }
      }
    },
    "code_changes": {
      "type": "object",
      "required": ["refs", "diff_policy"],
      "properties": {
        "refs": {
          "type": "object",
          "required": ["base_commit", "head_commit"],
          "properties": {
            "base_commit": { "type": "string", "minLength": 1 },
            "head_commit": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "diff_policy": { "type": "string" },
        "diff_command": { "type": "string" },
        "summary": {
          "type": "object",
          "properties": {
            "files_changed": { "type": "integer", "minimum": 0 },
            "insertions": { "type": "integer", "minimum": 0 },
            "deletions": { "type": "integer", "minimum": 0 }
          }
        },
        "files_list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "status": { "type": "string" },
              "added_lines": { "type": "integer", "minimum": 0 },
              "deleted_lines": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "quality_snapshot": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "tests": {
          "type": "object",
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "coverage": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "static_analysis": { "type": "object" },
        "performance": { "type": "object" }
      }
    },
    "executor_self_assessment": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "anchor": { "type": "string" },
        "what_was_done": { "type": "string" },
        "review_focus": { "type": "array", "items": { "type": "string" } },
        "known_limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review_guidelines": {
      "type": "object",
      "required": ["path", "commit", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "commit": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "history": {
      "type": ["array", "object"]
    },
    "references": {
      "type": ["array", "object"]
    }
  },
  "additionalProperties": false
}
