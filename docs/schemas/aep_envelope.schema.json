{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/aep_envelope.schema.json",
  "title": "MACAO AEP Message Envelope (all 8 types)",
  "type": "object",
  "required": ["protocol", "message_id", "timestamp", "type", "from", "to", "payload"],
  "properties": {
    "protocol": { "enum": ["AEP/1.0", "AEP/1.1"] },
    "message_id": { "type": "string", "pattern": "^msg-[0-9]{8}-[0-9A-Za-z_-]+$" },
    "timestamp": { "type": "string" },
    "type": {
      "enum": [
        "DEVELOPMENT_STARTED",
        "REVIEW_REQUEST",
        "REVIEW_RESPONSE",
        "REWORK_REQUEST",
        "DISPOSITION_REQUIRED",
        "MERGE_COMPLETED",
        "STATE_CHANGED",
        "HUMAN_OVERRIDE_REQUEST"
      ]
    },
    "from": { "type": "string", "minLength": 1 },
    "to": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    },
    "payload": { "type": "object", "minProperties": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "DEVELOPMENT_STARTED" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["task_id", "specification_summary", "acceptance_criteria"],
            "properties": {
              "project": { "type": "string" },
              "task_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "maxLength": 2048 },
              "source_branch": { "type": "string" },
              "target_branch": { "type": "string" },
              "specification_summary": { "type": "string", "maxLength": 2048, "minLength": 1 },
              "acceptance_criteria": {
                "type": "array",
                "items": { "type": "string", "maxLength": 2048 },
                "minItems": 1
              },
              "task_description": { "type": "string", "maxLength": 2048 },
              "expected_output": { "type": "object" },
              "success_criteria": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "REVIEW_REQUEST" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["checkpoint_ref", "review_round", "review_context"],
            "properties": {
              "project": { "type": "string" },
              "task_id": { "type": "string" },
              "executor": { "type": "string" },
              "checkpoint_ref": { "type": "string", "minLength": 1 },
              "review_round": { "type": "integer", "minimum": 1 },
              "review_context": { "$ref": "review_context.schema.json" },
              "isolated_worktree_path": { "type": "string" },
              "deadline": { "type": "string" },
              "review_deadline": { "type": "string" },
              "expected_output": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "REVIEW_RESPONSE" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["checkpoint_ref", "review_round"],
            "properties": {
              "project": { "type": "string" },
              "checkpoint_ref": { "type": "string", "minLength": 1 },
              "review_round": { "type": "integer", "minimum": 1 },
              "review_file": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" }
                },
                "additionalProperties": false
              },
              "manifest_ref": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" }
                },
                "additionalProperties": false
              },
              "vote_summary": {
                "type": "object",
                "properties": {
                  "vote": { "type": "string" },
                  "issues_count": { "type": "integer" },
                  "blocking_count": { "type": "integer" }
                },
                "additionalProperties": false
              },
              "vote": { "enum": ["YES_APPROVE", "NO_APPROVE", "ABSTAIN"] },
              "opinion_status": { "type": "string" },
              "confidence": { "type": "number" },
              "issues_count": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "REWORK_REQUEST" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["checkpoint_ref"],
            "properties": {
              "project": { "type": "string" },
              "task_id": { "type": "string" },
              "checkpoint_ref": { "type": "string", "minLength": 1 },
              "round": { "type": "integer", "minimum": 1 },
              "review_round": { "type": "integer", "minimum": 1 },
              "next_round": { "type": "integer", "minimum": 1 },
              "disposition_reference": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" }
                },
                "additionalProperties": false
              },
              "disposition_ref": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" }
                },
                "additionalProperties": false
              },
              "issues_index_sha256": { "type": "string" },
              "next_checkpoint_deadline": { "type": "string" },
              "summary": { "type": "string", "maxLength": 2048 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "DISPOSITION_REQUIRED" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "task_id",
              "checkpoint_ref",
              "review_round",
              "vote_result_ref",
              "issues_index_sha256",
              "timeout_deadline"
            ],
            "properties": {
              "project": { "type": "string" },
              "task_id": { "type": "string", "minLength": 1 },
              "checkpoint_ref": { "type": "string", "minLength": 1 },
              "review_round": { "type": "integer", "minimum": 1 },
              "vote_result": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" },
                  "decision": { "type": "string" },
                  "issues_count": { "type": "integer" }
                },
                "additionalProperties": false
              },
              "vote_result_ref": {
                "type": "object",
                "required": ["path", "evidence_commit", "sha256"],
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" }
                },
                "additionalProperties": false
              },
              "issues_index_sha256": { "type": "string", "minLength": 1 },
              "deadline": { "type": "string" },
              "timeout_deadline": { "type": "string", "minLength": 1 },
              "expected_output": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "MERGE_COMPLETED" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["checkpoint_ref"],
            "properties": {
              "project": { "type": "string" },
              "task_id": { "type": "string" },
              "checkpoint_ref": { "type": "string", "minLength": 1 },
              "merged_commit": { "type": "string" },
              "merge_commit": { "type": "string" },
              "target_branch": { "type": "string" },
              "vote_result_path": { "type": "string" },
              "vote_result_ref": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" }
                },
                "additionalProperties": false
              },
              "merge_strategy": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "STATE_CHANGED" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["state"],
            "properties": {
              "project": { "type": "string" },
              "task_id": { "type": "string" },
              "state": { "type": "string", "minLength": 1 },
              "from_state": { "type": "string" },
              "to_state": { "type": "string" },
              "detail": { "type": "string", "maxLength": 2048 },
              "event": { "type": "string" },
              "attachments": { "type": "array" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HUMAN_OVERRIDE_REQUEST" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["trigger"],
            "properties": {
              "project": { "type": "string" },
              "task_id": { "type": "string" },
              "checkpoint_ref": { "type": "string" },
              "review_round": { "type": "integer", "minimum": 1 },
              "trigger": { "type": "string", "minLength": 1 },
              "context": { "type": "string", "maxLength": 2048 },
              "summary": { "type": "string", "maxLength": 2048 },
              "options": {
                "type": "array",
                "items": { "type": "string" }
              },
              "exempt_issue_ids_available": {
                "type": "array",
                "items": { "type": "string" }
              },
              "vote_breakdown": {
                "type": "object"
              },
              "deadline": { "type": "string" },
              "timeout_deadline": { "type": "string" },
              "vote_result_ref": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "evidence_commit": { "type": "string" },
                  "sha256": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
