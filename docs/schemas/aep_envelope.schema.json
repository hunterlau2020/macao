{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/aep_envelope.schema.json",
  "title": "MACAO AEP Message Envelope (all 8 types)",
  "type": "object",
  "required": ["protocol", "message_id", "timestamp", "type", "from", "to", "payload"],
  "properties": {
    "protocol": { "enum": ["AEP/1.0", "AEP/1.1"] },
    "message_id": { "type": "string", "pattern": "^msg-[0-9]{8}-[0-9A-Za-z_-]+$" },
    "timestamp": { "type": "string" },
    "type": {
      "enum": [
        "DEVELOPMENT_STARTED",
        "REVIEW_REQUEST",
        "REVIEW_RESPONSE",
        "REWORK_REQUEST",
        "DISPOSITION_REQUIRED",
        "MERGE_COMPLETED",
        "STATE_CHANGED",
        "HUMAN_OVERRIDE_REQUEST"
      ]
    },
    "from": { "type": "string", "minLength": 1 },
    "to": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
