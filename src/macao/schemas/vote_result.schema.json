{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/vote_result.schema.json",
  "title": "MACAO vote_result.json Consensus Record",
  "type": "object",
  "required": [
    "version",
    "checkpoint_ref",
    "review_round",
    "reviewers_total",
    "reviewers_responded",
    "reviewers_accounted",
    "votes",
    "policy_snapshot",
    "vote_breakdown",
    "input_artifacts",
    "issues_index",
    "issues_index_sha256",
    "requires_disposition",
    "decision",
    "resolution"
  ],
  "properties": {
    "version": { "type": "string" },
    "timestamp": { "type": "string" },
    "generated_at": { "type": "string" },
    "task_id": { "type": "string" },
    "checkpoint_ref": { "type": "string", "minLength": 1 },
    "executor": { "type": "string" },
    "executor_id": { "type": "string" },
    "review_round": { "type": "integer", "minimum": 1 },
    "reviewers_total": { "type": "integer", "minimum": 1 },
    "reviewers_responded": { "type": "integer", "minimum": 0 },
    "reviewers_accounted": { "type": "integer", "minimum": 0 },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "vote"],
        "properties": {
          "reviewer": { "type": "string" },
          "vote": { "enum": ["YES_APPROVE", "NO_APPROVE", "ABSTAIN"] },
          "weight": { "type": "integer", "minimum": 1 },
          "source": { "enum": ["manifest", "timeout"] },
          "confidence": { "type": "number" },
          "issues_count": { "type": "integer" }
        }
      }
    },
    "policy_snapshot": {
      "type": "object",
      "required": [
        "rule",
        "configured_seats",
        "configured_weight",
        "seat_quorum_required",
        "weight_quorum_required",
        "decision_threshold_numerator",
        "decision_threshold_denominator",
        "minimum_winning_seats"
      ],
      "properties": {
        "rule": { "type": "string" },
        "configured_seats": { "type": "integer", "minimum": 1 },
        "configured_weight": { "type": "integer", "minimum": 1 },
        "seat_quorum_required": { "type": "integer", "minimum": 1 },
        "weight_quorum_required": { "type": "integer", "minimum": 1 },
        "decision_threshold_numerator": { "type": "integer" },
        "decision_threshold_denominator": { "type": "integer" },
        "minimum_winning_seats": { "type": "integer", "minimum": 2 },
        "dictator_cap_enabled": { "type": "boolean", "const": true },
        "max_single_weight_share_numerator": { "type": "integer" },
        "max_single_weight_share_denominator": { "type": "integer" }
      }
    },
    "consensus_rule": { "type": "string" },
    "vote_breakdown": {
      "type": "object",
      "required": [
        "effective_seats",
        "effective_weight",
        "approve_seats",
        "approve_weight",
        "reject_seats",
        "reject_weight",
        "abstain_seats",
        "abstain_weight"
      ],
      "properties": {
        "approve": { "type": "integer", "minimum": 0 },
        "reject": { "type": "integer", "minimum": 0 },
        "abstain": { "type": "integer", "minimum": 0 },
        "effective_seats": { "type": "integer", "minimum": 0 },
        "effective_weight": { "type": "integer", "minimum": 0 },
        "approve_seats": { "type": "integer", "minimum": 0 },
        "approve_weight": { "type": "integer", "minimum": 0 },
        "reject_seats": { "type": "integer", "minimum": 0 },
        "reject_weight": { "type": "integer", "minimum": 0 },
        "abstain_seats": { "type": "integer", "minimum": 0 },
        "abstain_weight": { "type": "integer", "minimum": 0 }
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "reviewer": { "type": "string" },
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "evidence_commit": { "type": "string" },
          "message_id": { "type": "string" }
        }
      }
    },
    "issues_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "disposition_class", "severity", "title"],
        "properties": {
          "issue_id": { "type": "string" },
          "reviewer": { "type": "string" },
          "disposition_class": { "enum": ["BLOCKING", "ADVISORY"] },
          "severity": { "type": "string" },
          "title": { "type": "string" },
          "full_document": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "evidence_commit": { "type": "string" },
              "sha256": { "type": "string" },
              "anchor": { "type": "string" }
            }
          }
        }
      }
    },
    "issues_index_sha256": { "type": "string" },
    "requires_disposition": { "type": "boolean" },
    "decision": { "enum": ["APPROVED", "REWORK_REQUIRED", "DEADLOCK"] },
    "resolution": { "enum": ["automatic", "AUTO_WEIGHTED_CONSENSUS"] },
    "decision_confidence": { "type": "number" },
    "summary": { "type": "object" },
    "next_step": { "type": "object" }
  }
}
