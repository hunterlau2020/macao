{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/dev_manifest.schema.json",
  "title": "MACAO .dev.yml Development Checkpoint Manifest",
  "type": "object",
  "required": [
    "version",
    "executor",
    "development",
    "status",
    "signal",
    "review_round"
  ],
  "properties": {
    "version": { "type": "string" },
    "timestamp": { "type": "string" },
    "task_id": { "type": "string", "minLength": 1 },
    "checkpoint_ref": { "type": "string", "minLength": 1 },
    "review_round": { "type": "integer", "minimum": 1 },
    "executor": {
      "type": "object",
      "required": ["id", "cli"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "cli": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "full_document": {
      "type": "object",
      "required": ["path", "evidence_commit", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "evidence_commit": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "development": {
      "type": "object",
      "required": ["quality_metrics", "git"],
      "properties": {
        "phase": { "type": "string" },
        "description": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "type": { "type": "string" },
              "path": { "type": "string", "minLength": 1 },
              "changed_lines": { "type": "integer", "minimum": 0 },
              "coverage": { "type": "number" },
              "updated": { "type": "boolean" }
            }
          }
        },
        "checklist": { "type": "array", "items": { "type": "string" } },
        "quality_metrics": {
          "type": "object",
          "required": ["tests_passed"],
          "properties": {
            "tests_passed": { "type": "boolean" },
            "tests_exempt": { "type": "boolean" },
            "tests_total": { "type": "integer" },
            "test_coverage": { "type": "number" },
            "lint_errors": { "type": "integer" },
            "security_scan_passed": { "type": "boolean" }
          }
        },
        "git": {
          "type": "object",
          "required": ["latest_commit"],
          "properties": {
            "latest_commit": { "type": "string", "minLength": 1 },
            "branch": { "type": "string" },
            "files_changed": { "type": "integer" }
          }
        },
        "review_focus": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "const": "ready_for_review" },
    "signal": { "enum": ["EXPLICIT", "IMPLICIT"] }
  }
}
