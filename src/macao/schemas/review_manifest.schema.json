{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://macao.dev/schemas/v2.5/review_manifest.schema.json",
  "title": "MACAO .review.yml Reviewer Opinion Manifest",
  "type": "object",
  "required": [
    "version",
    "reviewer",
    "checkpoint_ref",
    "review_round",
    "opinion",
    "vote"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "object",
      "required": [
        "id",
        "cli"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "cli": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "checkpoint_ref": {
      "type": "string",
      "minLength": 1
    },
    "review_round": {
      "type": "integer",
      "minimum": 1
    },
    "full_document": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "evidence_commit": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "opinion": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPROVED",
            "CHANGES_REQUESTED",
            "REJECTED",
            "ABSTAINED"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "feedback_summary": {
          "type": "string"
        },
        "feedback": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "severity_breakdown": {
              "type": "object",
              "properties": {
                "critical": {
                  "type": "integer",
                  "minimum": 0
                },
                "major": {
                  "type": "integer",
                  "minimum": 0
                },
                "minor": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "categories": {
              "type": "array"
            },
            "automated_checks": {
              "type": "array"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "disposition_class",
          "severity",
          "title"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "disposition_class": {
            "enum": [
              "BLOCKING",
              "ADVISORY"
            ]
          },
          "severity": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "full_document": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "evidence_commit": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "vote": {
      "enum": [
        "YES_APPROVE",
        "NO_APPROVE",
        "ABSTAIN"
      ]
    },
    "abstain_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "opinion": {
            "type": "object",
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "opinion"
        ]
      },
      "then": {
        "properties": {
          "vote": {
            "const": "YES_APPROVE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "opinion": {
            "type": "object",
            "properties": {
              "status": {
                "const": "CHANGES_REQUESTED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "opinion"
        ]
      },
      "then": {
        "properties": {
          "vote": {
            "const": "NO_APPROVE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "opinion": {
            "type": "object",
            "properties": {
              "status": {
                "const": "REJECTED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "opinion"
        ]
      },
      "then": {
        "properties": {
          "vote": {
            "const": "NO_APPROVE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "opinion": {
            "type": "object",
            "properties": {
              "status": {
                "const": "ABSTAINED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "opinion"
        ]
      },
      "then": {
        "properties": {
          "vote": {
            "const": "ABSTAIN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vote": {
            "const": "ABSTAIN"
          }
        },
        "required": [
          "vote"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          },
          "abstain_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "abstain_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "vote": {
            "const": "YES_APPROVE"
          }
        },
        "required": [
          "vote"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "properties": {
                "disposition_class": {
                  "not": {
                    "const": "BLOCKING"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "items": {
            "type": "array",
            "contains": {
              "properties": {
                "disposition_class": {
                  "const": "BLOCKING"
                }
              },
              "required": [
                "disposition_class"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "then": {
        "properties": {
          "vote": {
            "const": "NO_APPROVE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vote": {
            "const": "NO_APPROVE"
          }
        },
        "required": [
          "vote"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "properties": {
                "disposition_class": {
                  "const": "BLOCKING"
                }
              },
              "required": [
                "disposition_class"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    }
  ]
}